ADMIN_USERNAME=admin
ADMIN_PASSWORD=
# Optional Apprise notification URLs (one per line or comma-separated; mixed
# providers allowed, e.g. tgram://<token>/<chat_id> and ntfy://<topic>).
# Seeded ONLY on first boot when the settings table is empty (spec 5.1);
# afterwards the DB/UI wins. NOTIFY_ENABLED is optional: default is on,
# set false to boot with notifications disabled.
NOTIFY_URLS=
NOTIFY_ENABLED=
MUSIC_LIBRARY_PATH=/srv/musica
TZ=Europe/Rome
LOG_LEVEL=INFO
DATA_DIR=/data
COVERS_DIR=/data/covers
DEV_INSECURE_COOKIES=false
# Cloudflare Tunnel token (profile "cloudflare"): required only when a domain is
# available — see deploy/cloudflared.md (deferred to phase 14).
CF_TUNNEL_TOKEN=
# Tailscale (profile "tailscale", active): reuse an auth key from the admin
# console for unattended joins, or leave empty and log in interactively on the
# first boot (deploy/tailscale.md). Without a domain, use ONLY --profile tailscale:
# the app is then reachable at https://nucs.<tailnet>.ts.net from tailnet devices.
TS_AUTHKEY=
TS_HOSTNAME=nucs
TS_STATE_DIR=/var/lib/tailscale
TRUSTED_PROXY_CIDRS=172.16.0.0/12,10.0.0.0/8
